@using TodoListApp.WebApi.Models.Models.TodoList
@model IEnumerable<ModelTodoList>

@{
    ViewData["Title"] = "Shared With Me";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="font-outfit fw-bold mb-0">Shared With Me</h2>

        <a asp-controller="TodoList"
           asp-action="Index"
           class="btn btn-outline-light rounded-pill px-3">
            Back
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="row justify-content-center mt-4">
            <div class="col-md-6 col-lg-5">
                <div class="glass-card text-center p-4 rounded-4">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    No shared lists
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4">

            @foreach (var item in Model)
            {
                <div class="col">

                    <div class="glass-card h-100 p-3 rounded-4 list-card">

                        <div class="mb-2">
                            <h5 class="fw-bold text-light text-clamp-1">
                                @item.Title
                            </h5>

                            <p class="text-secondary small text-clamp-2">
                                @item.Description
                            </p>
                        </div>

                        <div class="d-flex gap-2 flex-wrap mt-auto">

                            <a asp-controller="TodoList"
                               asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-info rounded-pill">
                                <i class="bi bi-eye"></i>
                            </a>

                            <a asp-controller="TodoTask"
                               asp-action="TasksByList"
                               asp-route-todoListId="@item.Id"
                               class="btn btn-sm btn-outline-light rounded-pill">
                                <i class="bi bi-list-task"></i>
                            </a>

                            <a asp-controller="TodoListShare"
                               asp-action="Members"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-secondary rounded-pill">
                                <i class="bi bi-people"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>