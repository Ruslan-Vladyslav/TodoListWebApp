@model TodoListApp.WebApp.Models.ShareTodoListViewModel

@{
    ViewData["Title"] = "Share Todo List";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <h2 class="mb-3 font-outfit fw-bold text-center">Share List</h2>

            <div class="glass-card p-3 mb-3">
                <h4>@Model.Title</h4>
                <p class="text-secondary">@Model.Description</p>
            </div>

            <form asp-action="Share" method="post" class="glass-card p-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ListId" />

                <div class="mb-3">
                    <label asp-for="ReceiverInput" class="form-label fw-semibold">User</label>

                    <input asp-for="ReceiverInput"
                           class="form-control @(ViewData.ModelState[nameof(Model.ReceiverInput)]?.Errors.Count > 0 ? "is-invalid" : null)"
                           placeholder="Enter username or email" />

                    <span asp-validation-for="ReceiverInput" class="text-danger validation-message"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Role" class="form-label fw-semibold">Role</label>

                    <select asp-for="Role" class="form-select">
                        <option value="Viewer">Viewer</option>
                        <option value="Editor">Editor</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="Message" class="form-label fw-semibold">Message (optional)</label>
                    <textarea asp-for="Message" class="form-control" rows="3"></textarea>
                </div>

                <div class="d-flex justify-content-between mt-4">

                    <a asp-controller="TodoList"
                       asp-action="Index"
                       class="btn btn-outline-secondary rounded-pill px-4">
                        Back
                    </a>

                    <button type="submit" class="btn btn-success rounded-pill px-4">
                        Send Invitation
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
