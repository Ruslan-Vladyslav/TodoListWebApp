@using TodoListApp.WebApi.Models.Helper
@model TodoListApp.WebApp.Models.TasksPartialViewModel

@if (Model.Tasks != null && Model.Tasks.Any())
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

        @foreach (var task in Model.Tasks)
        {
            bool isCompleted = task.Status.ToString() == "Completed";
            bool isOverdue = task.DueDate < DateTime.Now && !isCompleted;
            bool isNotStarted = task.Status.ToString() == "NotStarted";

            string borderClass =
            isCompleted ? "border-success" :
            isOverdue ? "border-danger" :
            isNotStarted ? "border-secondary" :
            "border-warning";

            string badgeClass =
            isCompleted ? "bg-success" :
            isOverdue ? "bg-danger" :
            isNotStarted ? "bg-secondary" :
            "bg-warning text-dark";

            <div class="col">
                <div class="card h-100 shadow-sm border-3 @borderClass bg-dark text-light">
                    <div class="card-body p-3">

                        <h5 class="text-clamp-1">@task.Title</h5>

                        <span class="badge @badgeClass">
                            @task.Status.GetDisplayName()
                        </span>

                        <p class="text-secondary small mt-2 text-clamp-1">
                            @(task.Description ?? "No description")
                        </p>

                        <small>Created: @task.CreateDate</small><br />
                        <small>Due Date: @task.DueDate.ToShortDateString()</small>
                    </div>
                    <div class="card-footer bg-transparent border-0 text-end">
                        <a asp-action="Details"
                           asp-controller="TodoTask"
                           asp-route-id="@task.Id"
                           class="btn btn-sm btn-outline-info">
                            <i class="bi bi-info-circle"></i>
                        </a>
                    </div>
                </div>
            </div>
        }

    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">

                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    @if (Model.CurrentPage == 1)
                    {
                        <span class="page-link custom-dark text-muted">«</span>
                    }
                    else
                    {
                        <a class="page-link custom-dark"
                           href="@Url.Action(Model.Action, Model.Controller, new {
                                page = Model.CurrentPage - 1,
                                searchType = Model.SearchType,
                                tagId = Model.TagId,
                                title = Model.Title,
                                createDate = Model.CreateDate,
                                dueDate = Model.DueDate
                            })">
                            «
                        </a>
                    }
                </li>

                <li class="page-item shadow-sm">
                    <span class="page-link custom-dark">@Model.CurrentPage</span>
                </li>

                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    @if (Model.CurrentPage == Model.TotalPages)
                    {
                        <span class="page-link custom-dark text-muted">»</span>
                    }
                    else
                    {
                        <a class="page-link custom-dark"
                           href="@Url.Action(Model.Action, Model.Controller, new {
                                page = Model.CurrentPage + 1,
                                searchType = Model.SearchType,
                                tagId = Model.TagId,
                                title = Model.Title,
                                createDate = Model.CreateDate,
                                dueDate = Model.DueDate
                            })">
                            »
                        </a>
                    }
                </li>
            </ul>
        </nav>
    }
}
else
{
    <div class="alert alert-secondary text-center">
        No tasks found
    </div>
}