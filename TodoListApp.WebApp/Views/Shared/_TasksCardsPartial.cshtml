@using TodoListApp.Services.Enums
@using TodoListApp.WebApi.Models.Helper
@model TodoListApp.WebApp.Models.TasksPartialViewModel

@if (Model.Tasks != null && Model.Tasks.Any())
{
    <div class="row g-3">

        @foreach (var task in Model.Tasks)
        {
            bool isCompleted = task.Status == TodoTaskStatus.Completed;
            bool isOverdue = task.DueDate < DateTime.Now && !isCompleted;
            bool isNotStarted = task.Status == TodoTaskStatus.NotStarted;

            string borderClass =
            isCompleted ? "border-success" :
            isOverdue ? "border-danger" :
            isNotStarted ? "border-secondary" :
            "border-warning";

            string badgeClass =
            isCompleted ? "bg-success" :
            isOverdue ? "bg-danger" :
            isNotStarted ? "bg-secondary" :
            "bg-warning text-dark";

            <div class="col-12 col-md-6">
                <div class="glass-card p-3 h-100 border-start border-4 @borderClass transition-all rounded-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="fw-bold text-light text-clamp-1">
                            @task.Title
                        </h5>

                        <span class="badge @badgeClass">
                            @task.Status.GetDisplayName()
                        </span>
                    </div>

                    <p class="text-secondary small text-clamp-2">
                        @(task.Description ?? "No description")
                    </p>

                    <div class="d-flex justify-content-between mt-2">
                        <small class="text-muted">
                            Due: @task.DueDate.ToShortDateString()
                        </small>

                        <a asp-action="Details"
                           asp-controller="TodoTask"
                           asp-route-id="@task.Id"
                           class="btn btn-sm btn-outline-info rounded-pill px-3">
                            Details
                        </a>
                    </div>

                </div>

            </div>
        }

    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">

                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    @if (Model.CurrentPage == 1)
                    {
                        <span class="page-link custom-dark text-muted">«</span>
                    }
                    else
                    {
                        <a class="page-link custom-dark"
                           href="@Url.Action(Model.Action, Model.Controller, new {
                                page = Model.CurrentPage - 1,
                                searchType = Model.SearchType,
                                tagId = Model.TagId,
                                title = Model.Title,
                                createDate = Model.CreateDate,
                                dueDate = Model.DueDate,
                                fromDate = Model.FromDate,
                                toDate = Model.ToDate
                            })">
                            «
                        </a>
                    }
                </li>

                <li class="page-item">
                    <span class="page-link custom-dark">@Model.CurrentPage</span>
                </li>

                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    @if (Model.CurrentPage == Model.TotalPages)
                    {
                        <span class="page-link custom-dark text-muted">»</span>
                    }
                    else
                    {
                        <a class="page-link custom-dark"
                           href="@Url.Action(Model.Action, Model.Controller, new {
                                page = Model.CurrentPage + 1,
                                searchType = Model.SearchType,
                                tagId = Model.TagId,
                                title = Model.Title,
                                createDate = Model.CreateDate,
                                dueDate = Model.DueDate,
                                fromDate = Model.FromDate,
                                toDate = Model.ToDate
                            })">
                            »
                        </a>
                    }
                </li>
            </ul>
        </nav>
    }
}
else
{
    <div class="d-flex justify-content-center mt-4">
        <div class="glass-card text-center p-4 px-5 rounded-4"
             style="max-width: 380px; width: 100%;">
            <i class="bi bi-card-checklist fs-1 d-block mb-3"></i>
            <div class="text-secondary">
                No tasks found
            </div>
        </div>
    </div>
}