<!DOCTYPE html>
<html lang="uk" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TodoListApp.WebApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/additional.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TodoListApp.WebApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
@functions {
    string IsActive(string controller, string action = null)
    {
        var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();

        if (!string.IsNullOrEmpty(action))
        {
            return (currentController == controller && currentAction == action)
                ? "active"
                : "";
        }
        return currentController == controller ? "active" : "";
    }
}
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-sm navbar-dark glass-navbar mb-4">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold font-outfit" asp-area="" asp-controller="Home" asp-action="Index">TodoListApp</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link @IsActive("Home")" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @IsActive("TodoList")" asp-area="" asp-controller="TodoList" asp-action="Index">Todo-Lists</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @IsActive("TodoTask", "Index")" asp-area="" asp-controller="TodoTask" asp-action="Index">Tasks</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @IsActive("TodoTag")" asp-area="" asp-controller="TodoTag" asp-action="Index">Tags</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @IsActive("TodoTask", "Search")" asp-area="" asp-controller="TodoTask" asp-action="Search">Search</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <div class="d-flex align-items-center">
                                <a asp-controller="Account" asp-action="Profile" class="me-3 text-decoration-none nav-link">
                                    <i class="bi bi-person-circle"></i> @User.Identity.Name
                                </a>
                                @await Component.InvokeAsync("NavbarIndicators")
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm rounded-pill px-3 me-2">Login</a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-sm rounded-pill px-3">Register</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <main class="container flex-grow-1">
        @RenderBody()
    </main>

    <footer class="border-top border-secondary footer text-muted mt-5 py-3 glass-navbar">
        <div class="container text-center">
            &copy; 2026 - TodoListApp -
            <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none link-info">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/datetime-picker.js"></script>
    <script src="~/js/tooltips.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
