@using TodoListApp.WebApi.Models.Helper
@model IEnumerable<TodoListApp.WebApi.Models.Models.Notification.ModelNotification>

@{
    ViewData["Title"] = "Notifications";

    var unread = Model
        .Where(x => !x.IsRead)
        .OrderByDescending(x => x.CreateDate)
        .ToList();

    var read = Model
        .Where(x => x.IsRead)
        .OrderByDescending(x => x.CreateDate)
        .ToList();
}

<div class="container mt-4">

    @if (!Model.Any())
    {
        <div class="d-flex justify-content-center mt-5">
            <div class="glass-card text-center p-4 rounded-4"
                 style="max-width:420px; width:100%;">
                <i class="bi bi-bell-slash fs-1 d-block mb-3"></i>

                <div class="text-secondary">
                    No notifications found
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-center">
            <div style="max-width:900px; width:100%;">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <h2 class="font-outfit fw-bold mb-0">
                        Notifications
                    </h2>

                    <div class="d-flex align-items-center gap-2">

                        <span class="badge bg-warning text-dark rounded-pill px-3 py-2">
                            @unread.Count unread
                        </span>

                        @if (Model.Any())
                        {
                            <button class="btn btn-outline-danger rounded-pill" onclick="submitDeleteSelected()">
                                <i class="bi bi-trash"></i>
                                Delete Selected
                            </button>
                        }

                        @if (unread.Any())
                        {
                            <form asp-action="MarkAllRead" method="post" class="m-0">
                                @Html.AntiForgeryToken()

                                <button class="btn btn-outline-success rounded-pill">
                                    <i class="bi bi-check2-all"></i>
                                    Mark All Read
                                </button>
                            </form>
                        }
                    </div>
                </div>

                @if (unread.Any())
                {
                    <div class="glass-card p-4 mb-4">

                        <h4 class="font-outfit text-warning mb-4">
                            <i class="bi bi-bell-fill me-2"></i>
                            New Notifications
                        </h4>

                        <div class="d-flex flex-column gap-3">
                            @foreach (var item in unread)
                            {
                                <div class="glass-card p-3 border-start border-4 border-warning d-flex align-items-center gap-3">

                                    <div class="form-check m-0">
                                        <input class="form-check-input notification-checkbox" type="checkbox" value="@item.Id" style="width: 1.2em; height: 1.2em; cursor: pointer;" />
                                    </div>

                                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center flex-grow-1">

                                        <div class="flex-grow-1">

                                            <div class="fw-bold mb-2">

                                                <span class="badge bg-warning text-dark me-2">
                                                    New
                                                </span>

                                                @item.Type.GetDisplayName()

                                            </div>

                                            <div class="text-secondary mb-2">
                                                @item.Text
                                            </div>

                                            <small class="text-muted">
                                                <i class="bi bi-clock me-1"></i>
                                                @item.CreateDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                            </small>

                                        </div>

                                        <div class="d-flex gap-2 mt-3 mt-md-0">

                                            <form asp-action="MarkRead" method="post">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.Id" />

                                                <button class="btn btn-outline-success btn-sm rounded-pill px-3">
                                                    <i class="bi bi-check2"></i>
                                                    Read
                                                </button>
                                            </form>

                                            <form asp-action="Delete" method="post">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.Id" />

                                                <button class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                                        onclick="return confirm('Delete notification?')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                    </div>
                }

                @if (read.Any())
                {
                    <div class="glass-card p-4">

                        <h4 class="font-outfit text-secondary mb-4">
                            <i class="bi bi-check-circle me-2"></i>
                            Read Notifications
                        </h4>

                        <div class="d-flex flex-column gap-3">

                            @foreach (var item in read)
                            {
                                <div class="glass-card p-3 opacity-75 d-flex align-items-center gap-3">

                                    <div class="form-check m-0">
                                        <input class="form-check-input notification-checkbox" type="checkbox" value="@item.Id" style="width: 1.2em; height: 1.2em; cursor: pointer;" />
                                    </div>

                                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center flex-grow-1">

                                        <div class="flex-grow-1">

                                            <div class="fw-bold mb-2">
                                                @item.Type.GetDisplayName()
                                            </div>

                                            <div class="text-secondary mb-2">
                                                @item.Text
                                            </div>

                                            <small class="text-muted">
                                                <i class="bi bi-clock me-1"></i>
                                                @item.CreateDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                            </small>

                                        </div>

                                        <form asp-action="Delete"
                                              method="post"
                                              class="mt-3 mt-md-0">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.Id" />

                                            <button class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                                    onclick="return confirm('Delete notification?')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>

                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <form id="deleteSelectedForm" asp-action="DeleteSelected" method="post" style="display:none;">
        @Html.AntiForgeryToken()
    </form>
</div>

<script src="~/js/Notification-page.js"></script>