@model IEnumerable<TodoListApp.WebApi.Models.Models.TodoTask.ModelTodoTask>
@using TodoListApp.Services.Enums
@using TodoListApp.WebApi.Models.Enums
@using System.Security.Claims

@{
    ViewData["Title"] = "Todo Tasks by List";
    var role = ViewBag.Role as TodoListRole?;
    var currentUserId = User.FindFirstValue(System.Security.Claims.ClaimTypes.NameIdentifier);
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="font-outfit fw-bold">Tasks in "@ViewBag.TodoListName"</h1>
        <div class="d-flex gap-2">
            @if (role == TodoListRole.Owner || role == TodoListRole.Editor)
            {
                <a asp-action="Create" asp-route-todoListId="@ViewBag.TodoListId" class="btn btn-primary rounded-pill px-3">
                    <i class="bi bi-plus-circle"></i> New Task
                </a>
            }
            <a asp-action="Index" asp-controller="TodoList" class="btn btn-outline-secondary rounded-pill px-3">
                Back to Lists
            </a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive glass-card rounded-3">
            <table class="table table-hover align-middle text-center mb-0 table-fixed table-glass">

                <thead>
                    <tr>
                        <th style="width: 20%;">Title</th>
                        <th style="width: 25%;">Description</th>
                        <th style="width: 11%;">Created</th>
                        <th style="width: 11%;">Due</th>
                        <th style="width: 11%;">Assigned</th>
                        <th style="width: 11%;">Status</th>
                        <th style="width: 11%;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        var isCompleted = item.Status == TodoTaskStatus.Completed;
                        var isNotStarted = item.Status == TodoTaskStatus.NotStarted;
                        var isInProgress = item.Status == TodoTaskStatus.InProgress;
                        var isOverdue = item.DueDate < DateTime.Now && !isCompleted;

                        <tr class="task-row" data-id="@item.Id">

                            <td class="fw-semibold text-ellipsis">
                                @item.Title
                            </td>

                            <td class="text-secondary text-ellipsis">
                                @(string.IsNullOrWhiteSpace(item.Description)
                                    ? "No description"
                                    : item.Description)
                            </td>

                            <td>
                                @item.CreateDate.ToShortDateString()
                            </td>

                            <td>
                                @item.DueDate.ToShortDateString()
                            </td>

                            <td class="text-ellipsis">
                                @if (!string.IsNullOrEmpty(item.AssignedUserName))
                                {
                                    @item.AssignedUserName
                                    @if (item.AssignedUserId == item.ListOwnerId)
                                    {
                                        @if (currentUserId == item.ListOwnerId)
                                        {
                                            <br /><small class="text-muted">(Owner)</small>
                                        }
                                        else
                                        {
                                            <br /><small class="text-muted">(List Owner)</small>
                                        }
                                    }
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Unassigned</span>
                                }
                            </td>

                            <td>
                                @if (isCompleted)
                                {
                                    <span class="badge bg-success">Done</span>
                                }
                                else if (isOverdue)
                                {
                                    <span class="badge bg-danger">Overdue</span>
                                }
                                else if (isNotStarted)
                                {
                                    <span class="badge bg-secondary">Not started</span>
                                }
                                else if (isInProgress)
                                {
                                    <span class="badge bg-warning text-dark">In progress</span>
                                }
                            </td>

                            <td>
                                <div class="d-flex justify-content-center gap-1"
                                     onclick="event.stopPropagation()">

                                    @if (role == TodoListRole.Owner || role == TodoListRole.Editor)
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-warning"
                                           title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-info"
                                       title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    @if (role == TodoListRole.Owner)
                                    {
                                        <a asp-action="DeleteConfirm"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger"
                                           title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }

                                </div>
                            </td>

                        </tr>
                    }
                </tbody>

            </table>
        </div>
        @if (ViewBag.TotalPages > 1)
        {
            <nav aria-label="Task pagination" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link custom-dark"
                           href="@Url.Action("TasksByList", new { todoListId = ViewBag.TodoListId, page = ViewBag.CurrentPage - 1, sortBy = ViewBag.SortBy })"
                           aria-label="Previous">
                            &laquo;
                        </a>
                    </li>
                    <li class="page-item">
                        <a class="page-link custom-dark"
                           href="@Url.Action("TasksByList", new { todoListId = ViewBag.TodoListId, page = ViewBag.CurrentPage, sortBy = ViewBag.SortBy })">
                            @ViewBag.CurrentPage
                        </a>
                    </li>
                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link custom-dark"
                           href="@Url.Action("TasksByList", new { todoListId = ViewBag.TodoListId, page = ViewBag.CurrentPage + 1, sortBy = ViewBag.SortBy })"
                           aria-label="Next">
                            &raquo;
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="d-flex justify-content-center mt-4">
            <div class="glass-card text-center p-4 px-5 rounded-4"
                 style="max-width: 420px; width: 100%;">
                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                No tasks found in this Todo List
            </div>
        </div>
    }
</div>


<script src="~/js/TaskByList.js"></script>