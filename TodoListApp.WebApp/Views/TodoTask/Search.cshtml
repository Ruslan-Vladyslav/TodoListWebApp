@model TodoListApp.WebApp.Models.TasksPartialViewModel

@{
    ViewData["Title"] = "Search Tasks";
}

<div class="container-fluid mt-4">
    <div class="row g-4 align-items-start">
        <div class="col-md-4 col-lg-3 glass-card p-4 rounded-3 shadow-sm mb-4" style="min-height: 42vh;">
            <h3 class="mb-4 text-center">Search Tasks</h3>

            <form asp-action="Search" method="get">
                <div class="mb-4">
                    <label class="form-label">Search by:</label>
                    <select asp-for="SearchType" asp-items="@ViewBag.SearchTypeOptions"
                            class="form-select"
                            onchange="this.form.submit()"></select>
                </div>

                @if (Model.SearchType == "Title")
                {
                    <div class="mb-3">
                        <label asp-for="Title" class="text-light"></label>
                        <input asp-for="Title" class="form-control" placeholder="Enter title..." />
                    </div>
                }
                else if (Model.SearchType == "CreationDate")
                {
                    <div class="mb-3">
                        <label asp-for="CreateDate" class="text-light"></label>
                        <input asp-for="CreateDate" type="date" class="form-control" />
                    </div>
                }
                else if (Model.SearchType == "DueDate")
                {
                    <div class="mb-3">
                        <label asp-for="DueDate" class="text-light"></label>
                        <input asp-for="DueDate" type="date" class="form-control" />
                    </div>
                }
                else if (Model.SearchType == "Tag")
                {
                    <div class="mb-3">
                        <label class="text-light">Select Tag</label>
                        <select asp-for="TagId" asp-items="@ViewBag.Tags" class="form-select">
                            <option value="">-- Choose a tag --</option>
                        </select>
                    </div>
                }
                else if (Model.SearchType == "DateRange")
                {
                    <div class="mb-3">
                        <label class="text-light">
                            From
                        </label>

                        <input asp-for="FromDate"
                               type="date"
                               class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="text-light">
                            To
                        </label>

                        <input asp-for="ToDate"
                               type="date"
                               class="form-control" />
                    </div>
                }

                <div class="d-flex justify-content-between">
                    <button type="submit" class="btn btn-outline-light">Search</button>
                    <a asp-action="Search"
                       class="btn btn-outline-light"
                       asp-route-searchType="Title">
                        Reset
                    </a>
                </div>
            </form>
        </div>

        <div class="col-md-8 col-lg-9">
            @await Html.PartialAsync("_TasksCardsPartial", Model)
        </div>
    </div>
</div>