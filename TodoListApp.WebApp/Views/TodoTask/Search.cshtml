@model TodoListApp.WebApi.Models.Models.TodoTask.SearchTasksViewModel

@{
    ViewData["Title"] = "Search Tasks";
}

<div class="container-fluid mt-4">
    <div class="row g-4">
        <div class="col-md-4 col-lg-3 bg-dark text-light p-4 rounded-3 shadow-sm" style="height: 42vh;">
            <h3 class="mb-4 text-center">Search Tasks</h3>

            <form asp-action="Search" method="post">
                <div class="mb-4">
                    <label class="form-label">Search by:</label>
                    <select asp-for="SearchType" asp-items="@ViewBag.SearchTypeOptions"
                            class="form-control bg-secondary text-light"
                            onchange="this.form.submit()"></select>
                </div>

                @if (Model.SearchType == "Title")
                {
                    <div class="mb-3">
                        <label asp-for="Title" class="text-light"></label>
                        <input asp-for="Title" class="form-control bg-secondary text-light" placeholder="Enter title..." />
                    </div>
                }
                else if (Model.SearchType == "CreationDate")
                {
                    <div class="mb-3">
                        <label asp-for="CreateDate" class="text-light"></label>
                        <input asp-for="CreateDate" type="date" class="form-control bg-secondary text-light" />
                    </div>
                }
                else if (Model.SearchType == "DueDate")
                {
                    <div class="mb-3">
                        <label asp-for="DueDate" class="text-light"></label>
                        <input asp-for="DueDate" type="date" class="form-control bg-secondary text-light" />
                    </div>
                }
                else if (Model.SearchType == "Tag")
                {
                    <div class="mb-3">
                        <label class="text-light">Select Tag</label>
                        <select asp-for="TagId" asp-items="@ViewBag.Tags" class="form-control bg-secondary text-light">
                            <option value="">-- Choose a tag --</option>
                        </select>
                    </div>
                }

                <div class="d-flex justify-content-between">
                    <button type="submit" class="btn btn-outline-light">Search</button>
                    <a asp-action="Search" class="btn btn-outline-light">Reset</a>
                </div>
            </form>
        </div>

        <div class="col-md-8 col-lg-9">
            @if (Model.Results != null && Model.Results.Any())
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                    @foreach (var task in Model.Results)
                    {
                        bool isCompleted = task.Status.ToString() == "Completed";
                        bool isOverdue = task.DueDate < DateTime.Now && !isCompleted;
                        bool isNotStarted = task.Status.ToString() == "NotStarted";

                        string borderClass =
                        isCompleted ? "border-success" :
                        isOverdue ? "border-danger" :
                        isNotStarted ? "border-secondary" :
                        "border-warning";

                        <div class="col">
                            <div class="card h-100 shadow-sm border-3 @borderClass bg-dark text-light">
                                <div class="card-body">
                                    <h5 class="card-title">@task.Title</h5>
                                    <p class="card-text text-muted">@task.Description</p>
                                    <small class="text-light d-block">
                                        <strong>Created:</strong> @task.CreateDate.ToShortDateString()
                                    </small>
                                    <small class="text-light d-block">
                                        <strong>Due:</strong> @task.DueDate.ToShortDateString()
                                    </small>

                                    @if (isCompleted)
                                    {
                                        <span class="badge bg-success mt-2">Completed</span>
                                    }
                                    else if (isOverdue)
                                    {
                                        <span class="badge bg-danger mt-2">Overdue</span>
                                    }
                                    else if (isNotStarted)
                                    {
                                        <span class="badge bg-secondary mt-2">Not Started</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark mt-2">In Progress</span>
                                    }

                                    <div class="mt-3">
                                        <a asp-action="Details" asp-controller="TodoTask" asp-route-id="@task.Id"
                                           class="btn btn-sm btn-outline-info me-1">
                                            <i class="bi bi-info-circle"></i> Details
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (ViewBag.TotalPages > 1)
                {
                    <nav aria-label="Task pagination" class="mt-4">
                        <ul class="pagination justify-content-center">

                            <li class="page-item @(ViewBag.Page == 1 ? "disabled" : "")">
                                <form asp-action="Search" method="post" class="d-inline">
                                    <input type="hidden" name="page" value="@(ViewBag.Page - 1)" />
                                    <input type="hidden" name="SearchType" value="@Model.SearchType" />
                                    <input type="hidden" name="Title" value="@Model.Title" />
                                    <input type="hidden" name="CreateDate" value="@Model.CreateDate" />
                                    <input type="hidden" name="DueDate" value="@Model.DueDate" />
                                    <input type="hidden" name="TagId" value="@Model.TagId" />
                                    <button type="submit"
                                            class="page-link custom-dark"
                                            style="min-width: 40px; text-align: center;">
                                        &laquo;
                                    </button>
                                </form>
                            </li>

                            <li class="page-item shadow-sm">
                                <form asp-action="Search" method="post" class="d-inline">
                                    <input type="hidden" name="page" value="@ViewBag.Page" />
                                    <input type="hidden" name="SearchType" value="@Model.SearchType" />
                                    <input type="hidden" name="Title" value="@Model.Title" />
                                    <input type="hidden" name="CreateDate" value="@Model.CreateDate" />
                                    <input type="hidden" name="DueDate" value="@Model.DueDate" />
                                    <input type="hidden" name="TagId" value="@Model.TagId" />
                                    <button type="submit"
                                            class="page-link custom-dark fw-bold"
                                            style="min-width: 40px; background-color: #343a40 !important; color: #fff !important; border: none;">
                                        @ViewBag.Page
                                    </button>
                                </form>
                            </li>

                            <li class="page-item @(ViewBag.Page == ViewBag.TotalPages ? "disabled" : "")">
                                <form asp-action="Search" method="post" class="d-inline">
                                    <input type="hidden" name="page" value="@(ViewBag.Page + 1)" />
                                    <input type="hidden" name="SearchType" value="@Model.SearchType" />
                                    <input type="hidden" name="Title" value="@Model.Title" />
                                    <input type="hidden" name="CreateDate" value="@Model.CreateDate" />
                                    <input type="hidden" name="DueDate" value="@Model.DueDate" />
                                    <input type="hidden" name="TagId" value="@Model.TagId" />
                                    <button type="submit"
                                            class="page-link custom-dark"
                                            style="min-width: 40px; text-align: center;">
                                        &raquo;
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else if (Model.Results != null)
            {
                <div class="alert alert-secondary text-center mt-4">
                    No tasks found.
                </div>
            }
        </div>
    </div>
</div>