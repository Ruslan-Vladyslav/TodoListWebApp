@model TodoListApp.WebApi.Models.Models.TodoTask.UpdateTodoTask

@{
    ViewData["Title"] = "Edit Task";
}

<h1 class="text-dark text-center mb-4">Edit Task</h1>

<div class="row justify-content-center">
    <div class="col-md-7 bg-dark p-4 rounded shadow">
        <form asp-action="Edit" method="post" class="text-light">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="UserId" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="Title" class="form-label text-light fw-bold"></label>
                <input asp-for="Title" class="form-control bg-secondary text-light border-0" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="form-label text-light fw-bold"></label>
                <textarea asp-for="Description"
                          class="form-control bg-secondary text-light border-0"
                          style="height: 120px; resize: vertical; overflow-y: auto;">
                </textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="DueDate" class="form-label text-light fw-bold">
                    Due Date
                </label>

                <input asp-for="DueDate"
                       type="datetime-local"
                       class="form-control bg-secondary text-light border-0" />

                <span asp-validation-for="DueDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TodoListId" class="form-label text-light fw-bold">List</label>
                <select asp-for="TodoListId" class="form-select bg-secondary text-light border-0" asp-items="@ViewBag.ToDoLists"></select>
                <span asp-validation-for="TodoListId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="form-label text-light fw-bold">User</label>

                <input value="@Model.UserName"
                       class="form-control bg-secondary text-light border-0"
                       readonly />
            </div>

            <div class="form-group mb-4">
                <label class="form-label text-light fw-bold">Status</label>
                <select asp-for="Status" class="form-select bg-secondary text-light border-0" asp-items="@ViewBag.Statuses"></select>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                <input type="submit" value="Save Task" class="btn btn-primary" />
            </div>
        </form>

        <hr class="bg-light my-4" />

        <h4 class="text-light mb-2">Tags</h4>
        <div class="mb-3">
            @if (Model.Tags?.Any() == true)
            {
                foreach (var tag in Model.Tags)
                {
                    <form asp-action="RemoveTagFromTask" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="taskId" value="@Model.Id" />
                        <input type="hidden" name="tagId" value="@tag.Id" />
                        <span class="badge bg-secondary p-2 me-2">
                            @tag.Name
                            <button type="submit" class="btn btn-sm btn-danger p-0 ms-1" title="Remove Tag">&times;</button>
                        </span>
                    </form>
                }
            }
            else
            {
                <p class="text-light">No tags assigned.</p>
            }
        </div>

        <form asp-action="AddTagToTask" method="post" class="mb-3">
            <input type="hidden" name="taskId" value="@Model.Id" />
            <div class="input-group">
                <select name="tagId" class="form-select bg-secondary text-light border-0" asp-items="@ViewBag.Tags"></select>
                <button type="submit" class="btn btn-primary">Add existing</button>
            </div>
        </form>

        <form asp-action="CreateAndAddTag" method="post" class="mb-3">
            <input type="hidden" name="taskId" value="@Model.Id" />
            <div class="input-group">
                <input type="text" name="newTagName" class="form-control bg-secondary text-light border-0" placeholder="New tag name" />
                <button type="submit" class="btn btn-primary">Add New</button>
            </div>
        </form>

        <hr class="bg-light my-4" />

        <h4 class="text-light mb-2">Comments</h4>
        <div class="mb-3">
            @if (Model.Comments?.Any() == true)
            {
                foreach (var comment in Model.Comments)
                {
                    <form asp-action="DeleteCommentFromTask" method="post" class="d-inline">
                        <input type="hidden" name="taskId" value="@Model.Id" />
                        <input type="hidden" name="commentId" value="@comment.Id" />
                        <span class="badge bg-secondary p-2 me-2">
                            @comment.Text
                            <button type="submit" class="btn btn-sm btn-danger p-0 ms-1" style="line-height: 1.2;">&times;</button>
                        </span>
                    </form>
                }
            }
            else
            {
                <p class="text-light">No comments yet.</p>
            }
        </div>

        <form asp-action="AddCommentToTask" method="post" class="mb-3">
            <input type="hidden" name="taskId" value="@Model.Id" />
            <textarea name="commentContent" class="form-control bg-secondary text-light border-0 mb-2" placeholder="Add a comment..."></textarea>
            <button type="submit" class="btn btn-primary">Add Comment</button>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
