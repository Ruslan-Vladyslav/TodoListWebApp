@model TodoListApp.WebApi.Models.Models.TodoTask.ModelTodoTask
@{
    ViewData["Title"] = "Delete Task";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <div class="glass-card shadow-lg rounded-4">
                <div class="p-4">

                    <h2 class="text-danger mb-3 font-outfit fw-bold">
                        Delete Task
                    </h2>

                    <p class="text-secondary mb-3">
                        Are you sure you want to delete this task?
                    </p>

                    <hr class="border-secondary" />

                    <dl class="row mb-4">
                        <dt class="col-sm-4 text-secondary">Title</dt>
                        <dd class="col-sm-8 fw-semibold">@Model.Title</dd>

                        <dt class="col-sm-4 text-secondary">Description</dt>
                        <dd class="col-sm-8">@Model.Description</dd>

                        <dt class="col-sm-4 text-secondary">Due Date</dt>
                        <dd class="col-sm-8">@Model.DueDate.ToString("dd.MM.yyyy HH:mm")</dd>
                    </dl>

                    <div class="d-flex justify-content-between align-items-center">

                        <form asp-action="Delete"
                              method="post"
                              class="m-0"
                              onsubmit="return confirm('Are you sure you want to delete this task?');">

                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Id" />

                            <button type="submit"
                                    class="btn btn-danger rounded-pill px-4">
                                <i class="bi bi-trash"></i> Delete
                            </button>

                        </form>

                        <a asp-action="Index"
                           class="btn btn-outline-light rounded-pill px-4">
                            Back
                        </a>

                    </div>

                </div>
            </div>

        </div>
    </div>
</div>