@using TodoListApp.Services.Enums
@using TodoListApp.WebApi.Models.Enums
@using TodoListApp.WebApi.Models.Helper
@using System.Security.Claims
@model IEnumerable<TodoListApp.WebApi.Models.Models.TodoTask.ModelTodoTask>

@{
    ViewData["Title"] = "Assigned Tasks";
    var currentUserId = User.FindFirstValue(System.Security.Claims.ClaimTypes.NameIdentifier);
}

<div class="container-fluid mt-4">
    <div class="row align-items-start">
        <div class="col-md-4 col-lg-3 glass-card p-4 rounded-3 shadow-sm mb-4">
            <h3 class="mb-4 text-center font-outfit">Filters</h3>

            <form asp-action="Index" method="get">
                <input type="hidden" name="page" value="@ViewBag.Page" />

                <div class="mb-4">
                    Filter by Status:
                    <select class="form-select"
                            name="statusId"
                            asp-items="@ViewBag.StatusFilter"
                            onchange="this.form.submit()">
                    </select>
                </div>

                <div class="mb-4">
                    Sort By:
                    <select class="form-select"
                            name="sortBy"
                            asp-items="@ViewBag.SortOptions"
                            onchange="this.form.submit()">
                    </select>
                </div>

                <div class="d-flex justify-content-center">
                    <button type="button" class="btn btn-outline-light"
                            onclick="window.location.href='@Url.Action("Index", "TodoTask")'">
                        Reset
                    </button>
                </div>
            </form>
        </div>

        <div class="col-md-8 col-lg-9 p-2 rounded-3">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="font-outfit text-light fw-bold">Assigned Tasks</h2>
                <a asp-action="Create" class="btn btn-primary rounded-pill px-3">
                    <i class="bi bi-plus-circle"></i> New Task
                </a>
            </div>

            <hr />

            @if (!Model.Any())
            {
                <div class="alert alert-secondary text-center p-4">
                    No tasks found
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
                    @foreach (var item in Model)
                    {
                        bool isCompleted = item.Status == TodoTaskStatus.Completed;
                        bool isOverdue = item.DueDate < DateTime.Now && !isCompleted;
                        bool isNotStarted = item.Status == TodoTaskStatus.NotStarted;

                        string borderClass =
                        isCompleted ? "border-success" :
                        isOverdue ? "border-danger" :
                        isNotStarted ? "border-secondary" :
                        "border-warning";

                        string badgeClass =
                        isCompleted ? "bg-success" :
                        isOverdue ? "bg-danger" :
                        isNotStarted ? "bg-secondary" :
                        "bg-warning text-dark";

                        <div class="col">
                            <div class="glass-card border-2 @borderClass h-100 task-card hover-lift">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-start gap-2">

                                        <h5 class="card-title mb-0 text-clamp-1 flex-grow-1">
                                            @item.Title
                                        </h5>

                                        <span class="badge @badgeClass flex-shrink-0">
                                            @if (isOverdue)
                                            {
                                                @:Overdue
                                            }
                                            else
                                            {
                                                @item.Status.GetDisplayName()
                                            }
                                        </span>

                                        @if (item.IsShared)
                                        {
                                            <span class="badge bg-info text-dark flex-shrink-0 ms-1">
                                                <i class="bi bi-share-fill me-1"></i>Shared
                                            </span>
                                        }

                                    </div>

                                    <p class="card-text text-secondary small mb-2 text-clamp-1">

                                        @(string.IsNullOrWhiteSpace(item.Description)
                                            ? "No description"
                                            : item.Description)
                                    </p>

                                    <small class="text-light d-block">
                                        <strong>Created:</strong>
                                        @item.CreateDate.ToShortDateString()
                                    </small>

                                    <small class="text-light d-block">
                                        <strong>Due Date:</strong>
                                        @item.DueDate.ToShortDateString()
                                    </small>

                                    <small class="text-light d-block">
                                        <strong>Assigned To:</strong>
                                        @if (!string.IsNullOrEmpty(item.AssignedUserName))
                                        {
                                            @item.AssignedUserName
                                            @if (item.AssignedUserId == item.ListOwnerId)
                                            {
                                                @if (currentUserId == item.ListOwnerId)
                                                {
                                                    <span class="text-muted fst-italic">(Owner)</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted fst-italic">(List Owner)</span>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Unassigned</span>
                                        }
                                    </small>
                                </div>

                                <div class="card-footer bg-transparent border-0 py-2 px-3 d-flex justify-content-end gap-1">
                                    @if (item.Role == TodoListRole.Owner || item.Role == TodoListRole.Editor)
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-warning"
                                           title="Edit Task"
                                           data-bs-toggle="tooltip">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-info"
                                       title="View Details"
                                       data-bs-toggle="tooltip">
                                        <i class="bi bi-info-circle"></i>
                                    </a>

                                    @if (item.Role == TodoListRole.Owner)
                                    {
                                        <a asp-action="DeleteConfirm"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger"
                                           title="Delete Task"
                                           data-bs-toggle="tooltip">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
                @if (ViewBag.TotalPages > 1)
                {
                    <nav aria-label="Task pagination" class="mt-4">
                        <ul class="pagination justify-content-center">

                            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link custom-dark"
                                   href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1, sortBy = ViewBag.SortBy, statusId = ViewBag.StatusId })"
                                   aria-label="Previous">
                                    &laquo;
                                </a>
                            </li>

                            <li class="page-item">
                                <a class="page-link custom-dark"
                                   href="@Url.Action("Index", new { page = ViewBag.CurrentPage, sortBy = ViewBag.SortBy, statusId = ViewBag.StatusId })">
                                    @ViewBag.CurrentPage
                                </a>
                            </li>

                            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                                <a class="page-link custom-dark"
                                   href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1, sortBy = ViewBag.SortBy, statusId = ViewBag.StatusId })"
                                   aria-label="Next">
                                    &raquo;
                                </a>
                            </li>

                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>


<script>
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl)
    })
</script>
