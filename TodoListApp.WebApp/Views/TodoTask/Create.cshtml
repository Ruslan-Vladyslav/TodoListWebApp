@model TodoListApp.WebApi.Models.Models.TodoTask.CreateTodoTask

@{
    ViewData["Title"] = "Create Task";
}

<h1 class="text-dark mb-4">Create Task</h1>

<div class="row justify-content-center">
    <div class="col-md-6 bg-dark p-4 rounded shadow-sm">
        <form asp-action="Create" method="post" class="text-light">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control bg-secondary text-light" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control bg-secondary text-light"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TodoListId" class="form-label">Select ToDo List</label>
                <select asp-for="TodoListId" asp-items="ViewBag.TodoLists"
                        class="form-control bg-secondary text-light">
                    <option value="">-- Choose a list --</option>
                </select>
                <span asp-validation-for="TodoListId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DueDate" class="form-label"></label>
                <input asp-for="DueDate" type="date" class="form-control bg-secondary text-light" />
                <span asp-validation-for="DueDate" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between mt-3">
                <input type="submit" value="Create Task" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to Tasks</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
