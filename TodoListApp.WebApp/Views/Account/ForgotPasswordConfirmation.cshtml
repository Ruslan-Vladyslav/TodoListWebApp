@{
    ViewData["Title"] = "Email Sent";
}

<div class="container mt-5 d-flex justify-content-center">
    <div class="card bg-dark text-light shadow-lg p-5 text-center" style="max-width: 500px; width: 100%;">
        <h2 class="mb-3">Check your email</h2>

        <p class="text-secondary">
            If an account with this email exists, we’ve sent a password reset link.
            Please check your inbox and spam folder.
        </p>

        <hr class="border-secondary" />

        <p class="small text-muted">
            Didn’t receive the email? You can try again or check if the email was typed correctly.
        </p>

        <div class="d-flex justify-content-center gap-2 mt-3">
            <a asp-action="ForgotPassword" class="btn btn-outline-light">
                Try again
            </a>

            <a asp-action="Login" class="btn btn-primary">
                Back to login
            </a>
        </div>
    </div>
</div>