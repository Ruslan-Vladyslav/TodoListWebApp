@model TodoListApp.WebApi.Models.Models.Identity.ModelProfile

@{
    ViewData["Title"] = "Profile";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card bg-dark text-light shadow-lg border-0 rounded-4">
                <div class="card-body p-4">
                    <h2 class="card-title mb-4 text-center">Profile</h2>

                    <div class="d-flex justify-content-between align-items-center mb-3 p-3 rounded-3 bg-secondary bg-opacity-10">
                        <div>
                            <strong>Username:</strong> @Model.Username
                        </div>

                        <a asp-action="EditProfile"
                           class="btn btn-secondary btn-sm fixed-btn">
                            Edit
                        </a>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3 p-3 rounded-3 bg-secondary bg-opacity-10">
                        <div>
                            <strong>Email:</strong> @Model.Email
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3 p-3 rounded-3 bg-secondary bg-opacity-10">
                        <div>
                            <strong>Password:</strong> ••••••••••
                        </div>

                        <a asp-action="ChangePassword"
                           class="btn btn-secondary btn-sm fixed-btn">
                            Change
                        </a>
                    </div>

                    <hr class="border-secondary opacity-25" />

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-outline-secondary fixed-btn">
                            Back
                        </a>

                        <form asp-action="Delete" method="post"
                              onsubmit="return confirm('Are you sure?');">
                            <button class="btn btn-outline-danger">
                                <i class="bi bi-trash"></i> Delete Account
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>