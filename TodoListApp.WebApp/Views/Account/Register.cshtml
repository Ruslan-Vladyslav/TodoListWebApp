@model TodoListApp.WebApi.Models.Models.Identity.ModelRegister
@{
    ViewData["Title"] = "Register";
}

<div class="container d-flex justify-content-center align-items-center">
    <div class="card p-4 shadow-lg w-50">
        <h2 class="card-title text-center mb-4">Register</h2>

        <form asp-action="Register" method="post">
            <div class="mb-3">
                Username
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger d-block" style="min-height: 1.5em;"></span>
            </div>
            <div class="mb-3">
                Email
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger d-block" style="min-height: 1.5em;"></span>
            </div>
            <div class="mb-3">
                Password
                <input asp-for="Password" type="password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger d-block" style="min-height: 1.5em;"></span>
            </div>
            <div class="mb-3">
                ConfirmPassword
                <input asp-for="ConfirmPassword" type="password" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger d-block" style="min-height: 1.5em;"></span>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">Register</button>
            </div>

            <div class="text-center mt-3">
                Already have an account?
                <a asp-action="Login"
                   asp-controller="Account">
                    Login
                </a>
            </div>
        </form>

        @section Scripts {
            @await Html.PartialAsync("_ValidationScriptsPartial")
        }
    </div>
</div>
