@model TodoListApp.WebApp.Models.Account.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<div class="container mt-5 d-flex justify-content-center">
    <div class="glass-card shadow-lg p-5" style="max-width: 500px; width: 100%;">
        <h2 class="text-center mb-1 font-outfit fw-bold">Reset Password</h2>
        <p class="text-center text-muted mb-4">for @Model.Email</p>

        <form asp-action="ResetPassword" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label">New Password</label>
                <input asp-for="NewPassword"
                       type="password"
                       class="form-control" />
                <span asp-validation-for="NewPassword" class="text-danger d-block" style="min-height:1.5em;"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Confirm Password</label>
                <input asp-for="ConfirmPassword"
                       type="password"
                       class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger d-block" style="min-height:1.5em;"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 rounded-pill">
                Reset Password
            </button>

        </form>

        <div class="text-center mt-3">
            <a asp-action="Login" class="link-secondary">
                Back to login
            </a>
        </div>

    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}