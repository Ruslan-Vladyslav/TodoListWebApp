@model TodoListApp.WebApi.Models.Models.TodoList.ModelTodoList
@{
    ViewData["Title"] = "List Details";
}

<div class="container mt-4">
    <div class="card bg-dark text-light shadow-lg border-secondary border-2">
        <div class="card-body">
            <h2 class="card-title mb-4">List Details</h2>
            <hr class="border-secondary" />

            <dl class="row">
                <dt class="col-sm-3">Title</dt>
                <dd class="col-sm-9">@Model.Title</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                <dt class="col-sm-3">User Name</dt>
                <dd class="col-sm-9">@Model.UserId</dd>

                <dt class="col-sm-3">Tasks</dt>
                <dd class="col-sm-9">
                    @Model.TaskCount tasks
                </dd>
            </dl>

            <div class="mt-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning me-2">
                    <i class="bi bi-pencil"></i> Edit
                </a>
                <a asp-action="Index" class="btn btn-outline-light">
                    Back to List
                </a>
            </div>
        </div>
    </div>
</div>