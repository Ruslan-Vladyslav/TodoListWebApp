@using TodoListApp.WebApi.Models.Enums
@model TodoListApp.WebApi.Models.Models.TodoList.ModelTodoList
@{
    ViewData["Title"] = "List Details";
    var role = (TodoListRole)ViewBag.Role;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">

            <div class="glass-card shadow-lg">
                <div class="card-body p-4">
                    <div class="mb-3">
                        <h2 class="font-outfit fw-bold mb-1 text-center">
                            List Details
                        </h2>

                        <div class="text-secondary text-center">
                            Overview of your todo list
                        </div>
                    </div>

                    <hr class="border-secondary mb-4" />

                    <div class="d-flex flex-column gap-3">

                        <div class="d-flex">
                            <div class="text-secondary" style="min-width:120px;">
                                Title
                            </div>
                            <div class="fw-semibold ps-2">
                                @Model.Title
                            </div>
                        </div>

                        <div class="d-flex">
                            <div class="text-secondary" style="min-width:120px;">
                                Description
                            </div>

                            <div class="fw-semibold ps-2" style="max-width: 70%;">
                                @Model.Description
                            </div>
                        </div>

                        <div class="d-flex">
                            <div class="text-secondary" style="min-width:120px;">
                                User
                            </div>
                            <div class="fw-semibold ps-2">
                                @Model.UserName
                            </div>
                        </div>

                        <div class="d-flex">
                            <div class="text-secondary" style="min-width:120px;">
                                Tasks
                            </div>
                            <div class="fw-semibold ps-2">
                                @Model.TaskCount
                            </div>
                        </div>

                    </div>

                    <hr class="border-secondary my-4" />

                    <div class="d-flex justify-content-center flex-wrap gap-2">

                        @if (role == TodoListRole.Owner)
                        {
                            <a asp-action="Edit"
                               asp-route-id="@Model.Id"
                               class="btn btn-sm btn-outline-warning rounded-pill px-3"
                               data-bs-toggle="tooltip"
                               title="Edit List">
                                <i class="bi bi-pencil"></i>
                            </a>

                            <a asp-controller="TodoListShare"
                               asp-action="Share"
                               asp-route-id="@Model.Id"
                               class="btn btn-sm btn-primary rounded-pill px-3"
                               data-bs-toggle="tooltip"
                               title="Share List">
                                <i class="bi bi-share"></i>
                            </a>
                        }

                        <a asp-controller="TodoListShare"
                           asp-action="Members"
                           asp-route-id="@Model.Id"
                           class="btn btn-sm btn-outline-info rounded-pill px-3"
                           data-bs-toggle="tooltip"
                           title="Members">
                            <i class="bi bi-people"></i>
                        </a>

                        <a asp-controller="TodoTask"
                           asp-action="TasksByList"
                           asp-route-todoListId="@Model.Id"
                           class="btn btn-sm btn-outline-secondary rounded-pill px-3"
                           data-bs-toggle="tooltip"
                           title="Tasks">
                            <i class="bi bi-card-checklist"></i>
                        </a>

                        <a asp-action="Index"
                           class="btn btn-sm btn-outline-light rounded-pill px-3"
                           data-bs-toggle="tooltip"
                           title="Back to Lists">
                            <i class="bi bi-arrow-left"></i>
                        </a>

                    </div>

                </div>
            </div>

        </div>
    </div>
</div>