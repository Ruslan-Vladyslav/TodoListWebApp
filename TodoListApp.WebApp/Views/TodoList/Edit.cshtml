@model TodoListApp.WebApi.Models.Models.TodoList.UpdateTodoList

@{
    ViewData["Title"] = "Edit Todo List";
}

<h1 class="text-dark mb-4">Edit Todo List</h1>

<div class="row justify-content-center">
    <div class="col-md-6 bg-dark p-4 rounded shadow-sm">
        <form asp-action="Edit" method="post" class="text-light">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                Title
                <input asp-for="Title" class="form-control bg-secondary text-light" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                Description
                <input asp-for="Description" class="form-control bg-secondary text-light" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between mt-3">
                <input type="submit" value="Save List" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to Lists</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
