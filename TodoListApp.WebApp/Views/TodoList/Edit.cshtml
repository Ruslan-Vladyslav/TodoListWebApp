@model TodoListApp.WebApi.Models.Models.TodoList.UpdateTodoList

@{
    ViewData["Title"] = "Edit Todo List";
}

<h1 class="font-outfit fw-bold text-center mb-4">Edit Todo List</h1>

<div class="row justify-content-center">
    <div class="col-md-6 glass-card p-4 rounded shadow-sm">

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title"
                      class="text-danger d-block validation-message">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description"
                      class="text-danger d-block validation-message">
                </span>
            </div>

            <div class="d-flex justify-content-between mt-3">
                <button type="submit" class="btn btn-primary rounded-pill px-4">
                    Save List
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    Back to Lists
                </a>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}