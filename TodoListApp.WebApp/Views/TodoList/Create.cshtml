@model TodoListApp.WebApi.Models.Models.TodoList.CreateTodoList

@{
    ViewData["Title"] = "Create Todo List";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">

        <h1 class="font-outfit fw-bold mb-4">Create Todo List</h1>

        <div class="glass-card p-4 rounded shadow-sm">

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title"
                          class="text-danger d-block validation-message">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <input asp-for="Description" class="form-control" />
                    <span asp-validation-for="Description"
                          class="text-danger d-block validation-message">
                    </span>
                </div>

                <div class="d-flex justify-content-between">
                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        Create
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        Back to Lists
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}