@model TodoListApp.WebApi.Models.Models.TodoList.ModelTodoList
@{
    ViewData["Title"] = "Delete List";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <div class="glass-card shadow-lg">
                <div class="card-body p-4">
                    <div class="card-body p-4">

                        <h2 class="card-title text-danger mb-3 font-outfit fw-bold">
                            Delete List
                        </h2>

                        <p>Are you sure you want to delete this list?</p>

                        <hr class="border-secondary" />

                        <dl class="row">
                            <dt class="col-sm-3">Title</dt>
                            <dd class="col-sm-9">@Model.Title</dd>

                            <dt class="col-sm-3">Description</dt>
                            <dd class="col-sm-9">@Model.Description</dd>
                        </dl>

                        <div class="d-flex justify-content-between mt-4">
                            <form asp-action="Delete" method="post" class="m-0">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="id" value="@Model.Id" />

                                <button type="submit"
                                        class="btn btn-danger rounded-pill px-4"
                                        onclick="return confirm('Are you sure you want to delete this list?');">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </form>

                            <a asp-action="Index"
                               class="btn btn-outline-light rounded-pill px-4">
                                Back to lists
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>