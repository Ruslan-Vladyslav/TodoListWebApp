@model IEnumerable<TodoListApp.WebApi.Models.Models.TodoList.ModelTodoList>

@{
    ViewData["Title"] = "Todo Lists";
}

<div class="w-100 px-4 pt-4 pb-0">
    <div class="row g-4">
        <div class="col-12">
            <div class="--backgroung-color p-4 rounded-4 shadow">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="fw-bold text-dark">Todo Lists</h2>

                    <a asp-action="Create" class="btn btn-dark">
                        <i class="bi bi-plus-circle"></i> New List
                    </a>
                </div>

                <hr />

                @if (!Model.Any())
                {
                    <div class="alert alert-secondary text-center p-4 rounded-3">
                        No lists found
                    </div>
                }
                else
                {
                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
                        @foreach (var item in Model)
                        {
                            <div class="col">

                                <div class="card h-100 shadow-sm border-3 border-secondary bg-dark text-light">

                                    <div class="card-body">

                                        <h5 class="card-title text-light text-clamp-1">
                                            @item.Title
                                        </h5>

                                        <p class="card-text text-secondary small text-clamp-1">
                                            @item.Description
                                        </p>

                                        <div class="small text-light text-clamp-1">
                                            <strong>User:</strong> @item.UserId
                                        </div>
                                    </div>
                                    <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center">
                                        <div class="text-secondary small d-flex align-items-center gap-1"
                                             data-bs-toggle="tooltip"
                                             data-bs-placement="top"
                                             title="@item.TaskCount tasks">

                                            <span class="badge bg-secondary">
                                                <i class="bi bi-list-check"></i>
                                                @item.TaskCount
                                            </span>
                                        </div>

                                        <div class="d-flex gap-1">
                                            <a asp-action="Edit"
                                                asp-route-id="@item.Id"
                                                class="btn btn-sm btn-outline-warning">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <a asp-action="Details"
                                                asp-route-id="@item.Id"
                                                class="btn btn-sm btn-outline-info">
                                                <i class="bi bi-info-circle"></i>
                                            </a>

                                            <a asp-action="DeleteConfirm"
                                                asp-route-id="@item.Id"
                                                class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </a>

                                            <a asp-action="TasksByList"
                                                asp-controller="TodoTask"
                                                asp-route-todoListId="@item.Id"
                                                class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-card-checklist"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
@if (ViewBag.TotalPages > 1)
{
    <nav aria-label="TodoList pagination" class="mt-4">
        <ul class="pagination justify-content-center">

            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link custom-dark"
                   href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1 })">
                    &laquo;
                </a>
            </li>

            <li class="page-item shadow-sm">
                <a class="page-link custom-dark"
                   href="@Url.Action("Index", new { page = ViewBag.CurrentPage })">
                    @ViewBag.CurrentPage
                </a>
            </li>

            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link custom-dark"
                   href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1 })">
                    &raquo;
                </a>
            </li>

        </ul>
    </nav>
}