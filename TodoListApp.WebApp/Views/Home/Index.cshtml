@{
    ViewData["Title"] = "Home Page";
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
}

<div class="container text-center mt-5">
    @if (isAuthenticated)
    {
        <h1 class="display-4 mb-4 text-dark">Welcome, @User.Identity?.Name!</h1>

        <div class="mb-4">
            <p class="text-muted">Here you can manage your lists and tasks efficiently</p>
        </div>

        <div class="d-flex justify-content-center gap-3">
            <a href="@Url.Action("Index", "TodoList")" class="btn btn-secondary bg-dark btn-lg">View Lists</a>
            <a href="@Url.Action("Index", "TodoTask")" class="btn btn-secondary bg-dark btn-lg">Go to Tasks</a>
        </div>
    }
    else
    {
        <h1 class="display-4 mb-4 text-dark">Welcome to TodoListApp!</h1>
        <p class="lead text-muted mb-4">
            Keep track of your daily tasks, organize your workflow, and never miss deadlines
        </p>
        <p class="lead text-muted mb-4">Please log in or register to manage your tasks efficiently</p>

        <div class="d-flex justify-content-center gap-3">
            <a href="@Url.Action("Login", "Account")" class="btn btn-dark btn-lg">Login</a>
            <a href="@Url.Action("Register", "Account")" class="btn btn-dark btn-lg">Register</a>
        </div>
    }
</div>
